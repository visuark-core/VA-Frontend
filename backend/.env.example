# Google Sheets configuration for blog backend
GOOGLE_SHEETS_BLOG_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={...}

# Cloudinary configuration for image/media uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
